# 到 https://openrouter.ai/settings/keys 申请 OpenRouter API Key
OPENROUTER_API_KEY=

## 模型（默认使用 OpenRouter 上的 Gemini 3.7 Flash）
OPENROUTER_MODEL=google/gemini-3.7-flash

## 可选：网络代理（yt-dlp / requests 均可读取这些变量）
# 如无需代理，请留空
#HTTP_PROXY=
#HTTPS_PROXY=
#ALL_PROXY=

## 可选：仅给 yt-dlp 设置代理（优先级高于上面的通用代理）
#YT_DLP_PROXY=

## 可选：生成 Note 后通过 rclone 同步到远端
#RCLONE_REMOTE_PATH=remote:folder/path/

## 小宇宙订阅监控（token 文件必须在仓库外，权限建议 0600）
#XIAOYUZHOU_TOKEN_FILE=/home/your-user/.local/state/xiaoyuzhou/token.json
#RSSHUB_BASE_URL=http://127.0.0.1:1200
#RSSHUB_KEY=

# 说明：
# - CLI 会在启动时自动加载当前目录的 .env（若存在）。
# - 请复制本文件为 .env 并按需填写上述变量。

# 关闭自动翻译（供兼容该变量的外部集成使用）
NO_TRANSLATE=1
TRANSCRIBE_CONCURRENCY=2
# 每个音频分片独立尝试次数；失败只重试该分片
TRANSCRIBE_CHUNK_MAX_ATTEMPTS=3
# 分片重试基础等待秒数，后续按指数退避
TRANSCRIBE_RETRY_DELAY_SECONDS=5
EDIT_CONCURRENCY=6
